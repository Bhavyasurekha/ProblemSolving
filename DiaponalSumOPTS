class Solution {
    public int diagonalSum(int[][] mat) {
        int sum=0;
        int n=mat.length;
        for(int i=0;i<mat.length;i++){
            sum=sum+mat[i][i];
            sum=sum+mat[i][n-i-1];
        }
        if(mat.length%2!=0){
            int k=mat.length/2;
            sum=sum-mat[k][k];
        }
        return sum;
    }
}
