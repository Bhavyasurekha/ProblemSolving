class Solution {
    public boolean isPathCrossing(String path) {
        int x=0;
        int y=0;
        HashSet<String> hs = new HashSet<>();
        hs.add("0,0");
        for(int i=0;i<path.length();i++){
            if(path.charAt(i)=='N'){
                y=y+1;
            }else if(path.charAt(i)=='S'){
                y=y-1;
            }else if(path.charAt(i)=='E'){
                x=x+1;
            }else if(path.charAt(i)=='W'){
                x=x-1;
            }
            String pos= x+","+y;
            if(hs.contains(pos)){
                return true;
            }
            hs.add(pos);
        }
       return false;
    }
}
