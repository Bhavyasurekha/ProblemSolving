import java.util.*;
public class  HollowRhombos  {
    public static void main(String[]args){
        Scanner input = new Scanner(System.in);
        int n =input.nextInt();
        for(int i=0;i<n;i++){
            for(int j=n-i;j>0;j--){
                System.out.print(" ");
            }
            for(int k=0;k<n;k++){
                if(i==0 || i==n-1 || k==0 || k==n-1){
                    System.out.print("*");
                }else{
                    System.out.print(" ");
                }
                
            }
            System.out.println();
        }
    }
    
}
