import java.util.*;
public class ReverseArray {
    public static void rever(int arr[]){
        for(int i=0;i<arr.length;i++){
            System.out.print(arr[arr.length-1-i]+" ");
        }
    }
    public static void main(String[]args){
        int arr[]={1,2,3,4};
        rever(arr);
    }
    
}
