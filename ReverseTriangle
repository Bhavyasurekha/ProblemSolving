import java.util.*;
public class Reversetri {
    public static void rev(int n){
        for(int i=0;i<n;i++){
            for(int j=i;j<n;j++){
                System.out.print("* ");
            }
            System.out.println();
        }
    }
    public static void main(String[]args){
        Scanner input = new Scanner(System.in);
        int n = input.nextInt();
        rev(n);
    }
    
}
