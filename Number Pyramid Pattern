import java.util.*;
public class NumberPyramid {
    public static void main(String[]args){
        Scanner input = new Scanner(System.in);
        int n =input.nextInt();
        int k=1;
        for(int i=0;i<n;i++){
            for(int j=n-i;j>0;j--){
                System.out.print(" ");
            }
            for(int p=0;p<=i;p++){
                System.out.print(k+" ");
               
            }
             k++;
            System.out.println();
        }

    }   
}
