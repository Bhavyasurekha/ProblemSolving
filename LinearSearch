import java.util.*;
public class LinearSearch {
    public static boolean Linear(int nums[],int key){
        for(int i=0;i<nums.length;i++){
            if(nums[i]==key){
                return true;
            }
        }
        return false;
    }
    public static void main(String[]args){
        int key=4;
        int nums[]={9,2,3,4,5,6,7};
        System.out.print(Linear(nums,key));
    }
    
}
