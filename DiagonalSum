class Solution {
    public int diagonalSum(int[][] mat) {
        int sum=0;
        for(int i=0;i<mat.length;i++){
            for(int j=0;j<mat[0].length;j++){
                if(i==j){
                    sum=sum+mat[i][j];
                }
                if(i+j==mat.length-1){
                    sum=sum+mat[i][j];
                }
            }
        }
        if(mat.length%2!=0){
            int k=mat.length/2;
            sum=sum-mat[k][k];
        }
        return sum;
    }
}
