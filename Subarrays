class Main {
    public static void main(String[] args) {
      int arr[]={1,2,3,4,5,6};
      PrintSubarray(arr);
    }
    public static void PrintSubarray(int arr[]){
        for(int i=0;i<arr.length;i++){
            for(int j=i+1;j<arr.length;j++){
                for(int k=j+1;k<arr.length;k++){
                    System.out.print(arr[i]+" "+arr[j]+" "+arr[k]+"  ");
                }
                  System.out.println();
            }
            System.out.println();
        }
    }
}
